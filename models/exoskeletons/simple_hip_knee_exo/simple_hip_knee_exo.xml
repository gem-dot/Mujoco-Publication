<?xml version="1.0" encoding="UTF-8"?>
<mujoco model="simple_hip_knee_exo">
    <compiler angle="radian"/>
    <option timestep="0.001" gravity="0 0 -9.81"/>
    <visual>
        <global offwidth="1280" offheight="720"/>
    </visual>

    <worldbody>
        <light name="key" pos="1 -2 3" dir="-1 2 -3" directional="true"/>
        <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.01" rgba="0.75 0.78 0.82 1"/>

        <!-- Static pelvis frame with a right hip-thigh-knee-shank chain. -->
        <body name="exo_pelvis_frame" pos="0 0 0.82">
            <inertial mass="3.6" pos="-0.1507 0 0" diaginertia="0.0337194 0.0073206 0.0350406"/>
            <geom name="exo_pelvis_frame_geom" type="box" pos="-0.1507 0 0" size="0.055 0.10 0.10" rgba="0.15 0.42 0.80 0.88"/>
            <geom name="exo_pelvis_belt_rear_geom" type="box" pos="-0.0907 0 0" size="0.03 0.15 0.03" rgba="0.12 0.38 0.76 0.82"/>
            <geom name="exo_pelvis_belt_r_geom" type="box" pos="-0.0307 0.13 0" size="0.10 0.018 0.025" rgba="0.12 0.38 0.76 0.82"/>
            <geom name="exo_pelvis_belt_l_geom" type="box" pos="-0.0307 -0.13 0" size="0.10 0.018 0.025" rgba="0.12 0.38 0.76 0.82"/>

            <body name="exo_r_hip_module" pos="0 0.15 0">
                <joint name="HipExo_R" type="hinge" axis="0 1 0" range="-1.5 1.5" damping="1.0"/>
                <inertial mass="0.7" pos="0 0 0" diaginertia="0.0011025 0.0011025 0.00126"/>
                <geom name="exo_r_hip_module_geom" type="cylinder" pos="0 0 0" size="0.06 0.045" euler="1.5708 0 0" rgba="0.12 0.55 0.86 0.9"/>
                <body name="exo_r_thigh_bar" pos="0 0 0">
                    <inertial mass="1.2" pos="0 0 -0.10" diaginertia="0.00425 0.00074 0.00449"/>
                    <geom name="exo_r_thigh_bar_geom" type="box" pos="0 0 -0.20" size="0.035 0.025 0.20" rgba="0.12 0.45 0.82 0.88"/>
                    <body name="exo_r_knee_module" pos="0 0 -0.40">
                        <joint name="KneeExo_R" type="hinge" axis="0 1 0" range="-2.5 0.2" damping="1.0"/>
                        <inertial mass="0.15" pos="0 0 0" diaginertia="0.000195 0.000195 0.0001875"/>
                        <geom name="exo_r_knee_module_geom" type="cylinder" pos="0 0 0" size="0.05 0.045" euler="1.5708 0 0" rgba="0.12 0.55 0.86 0.9"/>
                        <body name="exo_r_shank_bar" pos="0 0 0">
                            <inertial mass="0.15" pos="0 0 -0.20" diaginertia="0.0020313 0.0000763 0.002045"/>
                            <geom name="exo_r_shank_bar_geom" type="box" pos="0 0 -0.20" size="0.03 0.025 0.20" rgba="0.12 0.45 0.82 0.88"/>
                        </body>
                    </body>
                </body>
            </body>

            <!-- Left chain is mirrored about the sagittal plane. -->
            <body name="exo_l_hip_module" pos="0 -0.15 0">
                <joint name="HipExo_L" type="hinge" axis="0 1 0" range="-1.5 1.5" damping="1.0"/>
                <inertial mass="0.7" pos="0 0 0" diaginertia="0.0011025 0.0011025 0.00126"/>
                <geom name="exo_l_hip_module_geom" type="cylinder" pos="0 0 0" size="0.06 0.045" euler="1.5708 0 0" rgba="0.82 0.30 0.16 0.9"/>
                <body name="exo_l_thigh_bar" pos="0 0 0">
                    <inertial mass="1.2" pos="0 0 -0.10" diaginertia="0.00425 0.00074 0.00449"/>
                    <geom name="exo_l_thigh_bar_geom" type="box" pos="0 0 -0.20" size="0.035 0.025 0.20" rgba="0.82 0.30 0.16 0.88"/>
                    <body name="exo_l_knee_module" pos="0 0 -0.40">
                        <joint name="KneeExo_L" type="hinge" axis="0 1 0" range="-2.5 0.2" damping="1.0"/>
                        <inertial mass="0.15" pos="0 0 0" diaginertia="0.000195 0.000195 0.0001875"/>
                        <geom name="exo_l_knee_module_geom" type="cylinder" pos="0 0 0" size="0.05 0.045" euler="1.5708 0 0" rgba="0.82 0.30 0.16 0.9"/>
                        <body name="exo_l_shank_bar" pos="0 0 0">
                            <inertial mass="0.15" pos="0 0 -0.20" diaginertia="0.0020313 0.0000763 0.002045"/>
                            <geom name="exo_l_shank_bar_geom" type="box" pos="0 0 -0.20" size="0.03 0.025 0.20" rgba="0.82 0.30 0.16 0.88"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="HipExo_R" joint="HipExo_R" gear="1" ctrlrange="-100 100" ctrllimited="true"/>
        <motor name="HipExo_L" joint="HipExo_L" gear="1" ctrlrange="-100 100" ctrllimited="true"/>
        <motor name="KneeExo_R" joint="KneeExo_R" gear="1" ctrlrange="-100 100" ctrllimited="true"/>
        <motor name="KneeExo_L" joint="KneeExo_L" gear="1" ctrlrange="-100 100" ctrllimited="true"/>
    </actuator>
</mujoco>
